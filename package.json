{
  "name": "emoji-spa",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "node ./node_modules/vite/bin/vite.js dev",
    "build:web": "node ./node_modules/vite/bin/vite.js build",
    "build:extension": "node scripts/build_extension.mjs",
    "build:extension:chrome": "node scripts/build_extension.mjs chrome",
    "build:extension:firefox": "node scripts/build_extension.mjs firefox",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "npx playwright test",
    "test:e2e:container": "npx playwright test --config=playwright.config.container.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "jsdom": "^24.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.5.0"
  }
}
