{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unicode Emoji Picker",
  "version": "0.1.0",
  "identifier": "com.example.unicode_emoji_picker",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unicode Emoji Picker",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}

