{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emoji Spa",
  "version": "0.0.7",
  "identifier": "emoji.spa",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emoji Spa",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "deb": {
      "postInstallScript": "scripts/refresh-linux-desktop-cache.sh",
      "postRemoveScript": "scripts/refresh-linux-desktop-cache.sh"
    },
    "rpm": {
      "postInstallScript": "scripts/refresh-linux-desktop-cache.sh",
      "postRemoveScript": "scripts/refresh-linux-desktop-cache.sh"
    }
  }
}
